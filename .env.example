# MS Extract (PDF → Markdown) — plantilla de configuración.
# Copiar a .env y ajustar los valores: cp .env.example .env
# Docker Compose lee .env para interpolar ${VAR:-default}; el entorno real del
# proceso tiene precedencia. Un valor inválido aborta el arranque (fail-fast).

# --- Servidor HTTP ---
# Puerto de escucha (1-65535).
PORT=8080
# Tope del documento PDF en MB (1-1024).
MAX_UPLOAD_MB=50
# Tope de páginas por documento; 0 desactiva el límite.
MAX_PAGES=1000
# Extracciones concurrentes por réplica (>= 1). Óptimo medido con cpus: 1.0: 2.
MAX_WORKERS=2
# Capacidad de la cola por réplica (>= 1). Con 2 workers, 56 cubre el
# desbalanceo del proxy sin 503 (58 trabajos en vuelo por réplica).
QUEUE_SIZE=56
# Presupuesto en MB de trabajos activos y pendientes (1-1024).
QUEUE_MAX_MB=256

# --- Timeouts (segundos) ---
READ_TIMEOUT=30
WRITE_TIMEOUT=30
# Deadline para dejar de aceptar y drenar la cola al apagar.
SHUTDOWN_TIMEOUT=35
# Margen de Docker por encima de SHUTDOWN_TIMEOUT (duración de Go: 45s, 1m).
STOP_GRACE_PERIOD=45s

# --- Logging ---
# Nivel mínimo: debug, info, warn o error.
LOG_LEVEL=info
# Formato de salida: json o text.
LOG_FORMAT=json

# --- pdf_oxide ---
# Ruta absoluta de libpdf_oxide.so. Obligatoria para ejecutar el binario fuera
# de Docker (make run) y para los tests de integración. Instalar con: make install
# La imagen Docker la fija en /opt/pdf_oxide/libpdf_oxide.so.
# PDF_OXIDE_LIB_PATH=/home/<usuario>/.cache/pdf_oxide/v0.3.78/lib/linux_amd64/libpdf_oxide.so

# --- Consul (opcional) ---
# Deshabilitado por defecto. Con CONSUL_ENABLED=true son obligatorios
# CONSUL_HTTP_ADDR, CONSUL_HTTP_TOKEN y CONSUL_KV_PREFIX.
CONSUL_ENABLED=false
# CONSUL_HTTP_ADDR=http://127.0.0.1:8500
# CONSUL_HTTP_TOKEN=
# CONSUL_HTTP_CA_FILE=
# CONSUL_KV_PREFIX=extract/config
# CONSUL_SERVICE_NAME=extract
# CONSUL_SERVICE_ID=
# CONSUL_SERVICE_ADDRESS=
# CONSUL_SERVICE_CHECK_URL=
# CONSUL_SERVICE_TAGS=
